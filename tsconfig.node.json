{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* 배치 스크립트(scripts/**.mjs)는 JSDoc 으로 타입을 단다. CLAUDE.md 의 "any 금지"를
       실제로 강제하려면 검사가 돌아야 하므로 checkJs 를 켜고 `tsc -b` 대상에 넣는다. */
    "allowJs": true,
    "checkJs": true,
    "strict": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "scripts"]
}
