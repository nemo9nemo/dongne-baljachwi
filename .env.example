# 실제 값은 .env.local 에 넣는다. .env.local 은 .gitignore 에 포함되어 있다.
# Vite는 VITE_ 접두사가 붙은 변수만 클라이언트 번들에 노출한다.

# ── Supabase ────────────────────────────────────────────────────────────────
# 브라우저에 노출되는 값. anon 키는 RLS 로 보호되는 것을 전제로 공개되어도 되는 키다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ⚠️ 서버(배치 스크립트) 전용. VITE_ 접두사를 절대 붙이지 마라 — 붙는 순간 브라우저에 노출된다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 카카오맵 ─────────────────────────────────────────────────────────────────
# 브라우저 키(JavaScript 키). 카카오 개발자 콘솔에서 플랫폼(웹) 도메인 등록 필수.
VITE_KAKAO_MAP_APP_KEY=

# ── 공공데이터포털 (TAGO) ────────────────────────────────────────────────────
# 서버(배치 스크립트) 전용. 역 마스터 데이터 적재 배치에서만 사용한다.
# 사용자 검색 요청 경로에서 직접 호출하지 않는다 — 조회는 항상 Supabase에 적재된 데이터로 한다.
TAGO_SERVICE_KEY=
