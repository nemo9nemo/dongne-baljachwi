# 실제 값은 .env.local 에 넣는다. .env.local 은 .gitignore 에 포함되어 있다.
# Vite는 VITE_ 접두사가 붙은 변수만 클라이언트 번들에 노출한다.

# ── 기기 저장 (기본) ────────────────────────────────────────────────────────
# 기본 앱은 로그인 없이 기기에 저장한다. 이전 Supabase 앱을 열 때만 supabase로 설정.
VITE_STORAGE_BACKEND=local
# 배포/Android 앱용 HTTPS 연결 서버의 origin. 개발에서는 비우면 Vite 내장 연결 서버 사용.
VITE_SHARE_SERVER=
# 아래는 연결 서버 전용. VITE_ 접두사를 붙이지 않는다.
SHARE_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
SHARE_HOST=127.0.0.1
SHARE_PORT=8787
# 기본은 tmp/share-connections.json. 운영에서는 웹 루트 밖의 영구 경로 사용.
SHARE_STATE_PATH=
# 선택: coturn REST 방식의 단기 중계 자격 증명. 영구 비밀은 서버에만 보관.
SHARE_TURN_URLS=
SHARE_TURN_SECRET=

# ── Supabase ────────────────────────────────────────────────────────────────
# 브라우저에 노출되는 값. anon 키는 RLS 로 보호되는 것을 전제로 공개되어도 되는 키다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ⚠️ 서버(배치 스크립트) 전용. VITE_ 접두사를 절대 붙이지 마라 — 붙는 순간 브라우저에 노출된다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 카카오맵 ─────────────────────────────────────────────────────────────────
# 브라우저 키(JavaScript 키). 카카오 개발자 콘솔에서 플랫폼(웹) 도메인 등록 필수.
VITE_KAKAO_MAP_APP_KEY=

# ── 공공데이터포털 (TAGO) ────────────────────────────────────────────────────
# 현재 기본 경로에서 쓰이지 않는다 — 엔드포인트 재확인 전까지 역 마스터의 공식 원천은
# 전국도시철도역사정보표준데이터(파일데이터)다 (docs/specs/02-station-master.md §9).
# 값이 채워져 있어도 배치가 자동 선택하지 않는다. 쓰려면 --source=tago 로 명시한다.
# 서버(배치 스크립트) 전용. 사용자 요청 경로에서는 직접 호출하지 않는다.
TAGO_SERVICE_KEY=
