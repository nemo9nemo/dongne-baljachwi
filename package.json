{
  "name": "dongne-baljachwi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "stations:load": "node --env-file-if-exists=.env.local scripts/load-station-master.mjs",
    "line-map:seed": "node --env-file-if-exists=.env.local scripts/seed-line-map.mjs",
    "line-map:build": "node scripts/build-line-map.mjs",
    "line-map:check": "node scripts/build-line-map.mjs --check && node scripts/verify-line-map.mjs --offline",
    "test:line-map": "node --test tests/line-map/line-map.test.mjs",
    "verify:line-map": "node --env-file-if-exists=.env.local scripts/verify-line-map.mjs",
    "test:db": "node supabase/tests/run.mjs",
    "test:browser": "node tests/browser/run-with-server.mjs",
    "service:inspect": "node --env-file-if-exists=.env.local scripts/inspect-service.mjs",
    "design:verify": "node tests/design/mockup.mjs",
    "photos:cleanup": "node --env-file-if-exists=.env.local scripts/cleanup-photos.mjs",
    "share:server": "node --env-file-if-exists=.env.local scripts/sharing/serve.mjs",
    "test:local": "node tests/local/run.mjs",
    "test:sharing": "node --test tests/local/broker.test.mjs",
    "test:android": "node tests/android/run.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "node scripts/build-android.mjs debug",
    "android:release": "node scripts/build-android.mjs release",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.112.2",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
